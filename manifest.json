{
  "manifest_version": 3,
  "name": "TGTC — BSC Token Lookup",
  "version": "1.4.0",
  "description": "One-click on-chain data for BSC tokens: price, safety, smart money — right in your browser. X (Twitter) inline token evaluation + popup lookup. Powered by tgtcbot.com.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TGTC — BSC Token Lookup"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.tgtcbot.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content-x.js"],
      "css": ["content-x.css"],
      "run_at": "document_idle"
    }
  ]
}
